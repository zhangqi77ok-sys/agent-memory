POSTGRES_PASSWORD=CHANGE_ME
WORKER_DB_PASSWORD=change-me-worker
APP_DB_PASSWORD=CHANGE_ME
APP_ID=tiancode
APP_ENV=prod
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=
LLM_MODEL=demo-model
EMBEDDING_MODEL=text-embedding-3-small
SERVICE_KEYS=change-me-key1,change-me-key2
# 多用户部署推荐：把密钥绑到用户（绑定后 user_id 断言失效，身份钉死）。
# SERVICE_KEY_USERS=change-me-key1:alice,change-me-key2:bob
# 单用户自用且沿用 user_id 断言时，显式声明后才放行；默认 0 = 未绑定断言一律 403。
ALLOW_UNBOUND_ASSERTION=0
WEB_PORT=8091
