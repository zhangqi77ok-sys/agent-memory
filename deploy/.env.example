# 复制为 /opt/agent-memory/.env（chmod 600），同样内容存进 Jenkins 凭据 deploy-env。只放假值！
ENV=prod
APP_ENV=prod
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
APP_DB_PASSWORD=change-me-openssl-rand-hex-32
WORKER_DB_PASSWORD=change-me-openssl-rand-hex-32
APP_ID=tiancode
API_BIND=127.0.0.1
API_PORT=8090
ROOT_PATH=/memory
# DOCS_ENABLED=true  # prod 默认关闭 /docs 和 /openapi.json；若需排错可设为 true
# 业务调用方服务密钥，支持逗号分隔多值用于轮换（只放假值）
SERVICE_KEYS=change-me-service-key-1,change-me-service-key-2
# 应用层 user_id 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_WRITE_PER_MIN=30
# Worker 抽取用的 OpenAI 兼容接口。示例指向 Docker 宿主机上的网关，不要写真实 IP 或密钥。
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=change-me
LLM_MODEL=demo-model
