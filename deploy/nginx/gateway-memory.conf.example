# 模板（不是线上配置）：nginx-gw 里 BrainWeave Memory 相关 location。
# Docker运维：请和线上实际配置 diff 后再改，不要直接覆盖。仓库里不放真实域名/IP。
# 该文件在 nginx-gw 中是「单文件 bind mount」：编辑后必须 `docker restart nginx-gw`，
# 不能只 `nginx -s reload`（编辑器换 inode 后容器里看到的仍是旧文件）。

# 裸路径 /memory 没有尾斜杠，前缀 location /memory/ 匹配不到。
location = /memory {
    return 301 /memory/;
}

# 前端必须写在 /memory/ 之前（更长前缀优先，也便于阅读）。
# proxy_pass 末尾【不带斜杠】：原样转发 /memory/ui/...，web 容器的 nginx 就是按 /memory/ui/ 提供静态文件的。
# /memory/ui/ 仅对内网和管理员开放，避免公网任意访问
location /memory/ui/ {
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 127.0.0.1;
    deny all;

    proxy_pass http://127.0.0.1:8091;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# 业务 API /memory/v1/：只放行内网和业务服务器 IP，其他一律 deny
# 需在 nginx.conf 的 http 块中定义：limit_req_zone $binary_remote_addr zone=mem_ip_limit:10m rate=30r/s;
# 超限返回 429：limit_req_status 429;
location /memory/v1/ {
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 127.0.0.1;
    # allow <BUSINESS_SERVER_IP>;  # 生产环境按需补充业务调用方 IP
    deny all;

    # 网关层 IP 限速防刷（结合应用层 user_id 双重保护）
    limit_req zone=mem_ip_limit burst=20 nodelay;

    client_max_body_size 50m;
    proxy_pass http://127.0.0.1:8090/v1/;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /memory;
}

# 通用反代与健康检查（如 /memory/readyz, /memory/healthz，用于 CI 冒烟与探针）：去掉 /memory 前缀
# client_max_body_size 与练习机一致，只限制这条反代，不放大整个网关的上传上限。
location /memory/ {
    client_max_body_size 50m;
    proxy_pass http://127.0.0.1:8090/;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /memory;
}
