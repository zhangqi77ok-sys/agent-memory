# 模板（不是线上配置）：nginx-gw 里 agent-memory 相关的两个 location。
# Docker运维：请和线上实际配置 diff 后再改，不要直接覆盖。仓库里不放真实域名/IP。
# 该文件在 nginx-gw 中是「单文件 bind mount」：编辑后必须 `docker restart nginx-gw`，
# 不能只 `nginx -s reload`（编辑器换 inode 后容器里看到的仍是旧文件）。

# 前端必须写在 /memory/ 之前（更长前缀优先，也便于阅读）。
# proxy_pass 末尾【不带斜杠】：原样转发 /memory/ui/...，web 容器的 nginx 就是按 /memory/ui/ 提供静态文件的。
location /memory/ui/ {
    proxy_pass http://127.0.0.1:8091;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# api：去掉 /memory 前缀（末尾带斜杠），api 端用 ROOT_PATH=/memory 生成正确的 docs/openapi 地址。
location /memory/ {
    proxy_pass http://127.0.0.1:8090/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /memory;
}
